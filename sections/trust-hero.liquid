          "default": "Beautiful jewellery for everyday wear and special moments."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Author"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.all.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.all.icon.options__1.label"
            },
            {
              "value": "seal-check",
              "label": "t:sections.all.icon.options__22.label"
            },
            {
              "value": "gift",
              "label": "t:sections.all.icon.options__8.label"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "truck",
              "label": "t:sections.all.icon.options__13.label"
            },
            {
              "value": "check-circle",
              "label": "t:sections.all.icon.options__15.label"
            },
            {
              "value": "tag",
              "label": "t:sections.all.icon.options__17.label"
            },
            {
              "value": "heart",
              "label": "t:sections.all.icon.options__10.label"
            },
            {
              "value": "package",
              "label": "t:sections.all.icon.options__11.label"
            }
          ],
          "default": "seal-check"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.all.description.label",
          "default": "Quality Checked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust hero",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
