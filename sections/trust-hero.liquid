        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "stars",
          "label": "t:sections.testimonials.blocks.testimonial.settings.icon.label",
          "options": [
            {
              "value": "none",
