{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign motion_delay = 0
-%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section--padding trust-badges color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="trust-badges__grid f-grid f-grid-1-cols sm:f-grid-2-cols md:f-grid-{{ section.settings.columns_desktop }}-cols f-grid--gap-large">
      {%- for block in section.blocks -%}
        {%- assign motion_delay = motion_delay | plus: 50 -%}
        <motion-element
          class="trust-badges__item flex flex-col items-center text-center"
          data-motion="fade-up"
          data-motion-delay="{{ motion_delay }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.custom_image != blank %}
            <div class="trust-badges__icon trust-badges__icon--image" aria-hidden="true">
              {{
                block.settings.custom_image
                | image_url: width: 200
                | image_tag: loading: 'lazy', sizes: '48px', widths: '48,64,96,128,200'
              }}
            </div>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="trust-badges__heading h6">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="trust-badges__text text-sm text-subtext">{{ block.settings.text }}</p>
          {% endif %}
        </motion-element>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.feature-list.item_settings_header"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "Quality Checked"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.all.description.label",
          "default": "Every piece is inspected before dispatch."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "heading": "Quality Checked",
            "text": "Every piece is inspected before dispatch."
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Gift-Ready Packaging",
            "text": "Ready to make their moment feel special."
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Secure Checkout",
            "text": "Your payment details stay protected."
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Nationwide Delivery",
            "text": "Carefully delivered across Pakistan."
          }
        }
      ]
    }
  ]
}
{% endschema %}
