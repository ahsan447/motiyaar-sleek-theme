{{ 'section-email-capture.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign motion_delay = 50
  assign default_placeholder = 'newsletter.label' | t
  assign default_placeholder = section.settings.placeholder | default: default_placeholder
  assign default_button_label = 'newsletter.button_label' | t
  assign default_button_label = section.settings.button_label | default: default_button_label
  assign form_id = 'EmailCapture-' | append: section.id
-%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section--padding email-capture color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="email-capture__box blocks-radius text-center" style="--box-width: {{ section.settings.box_width }}px;">
      {%- if section.settings.subheading != blank -%}
        <motion-element
          class="email-capture__eyebrow text-subheading block"
          data-motion="fade-up"
          data-motion-delay="{{ motion_delay }}"
        >
          {{- section.settings.subheading -}}
        </motion-element>
        {%- assign motion_delay = motion_delay | plus: 50 -%}
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="email-capture__heading {{ section.settings.heading_size }}">
          <motion-element data-motion="fade-up" data-motion-delay="{{ motion_delay }}" class="block">
            {% render 'highlight-text',
              text: section.settings.heading,
              style: section.settings.heading_highlight_style
            %}
          </motion-element>
        </h2>
        {%- assign motion_delay = motion_delay | plus: 50 -%}
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <motion-element
          class="email-capture__description rte {{ section.settings.text_size }} block"
          data-motion="fade-up"
          data-motion-delay="{{ motion_delay }}"
        >
          {{- section.settings.description -}}
        </motion-element>
        {%- assign motion_delay = motion_delay | plus: 50 -%}
      {%- endif -%}

      <motion-element
        data-motion="fade-up"
        data-motion-delay="{{ motion_delay }}"
        class="email-capture__form-wrapper block"
      >
        {%- form 'customer', id: form_id, is: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="email-capture__form">
            <div class="form-field relative">
              <label class="form-label visually-hidden" for="EmailCaptureInput-{{ section.id }}">
                {{ default_placeholder }}
              </label>
              <input
                id="EmailCaptureInput-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="form-control email-capture__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="EmailCapture-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="EmailCapture-success--{{ section.id }}"
                {% endif %}
                placeholder="{{ default_placeholder }}"
                required
              >
            </div>
            <button
              type="submit"
              class="email-capture__button btn {{ section.settings.button_style }}"
              name="commit"
            >
              {{- default_button_label -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="form-message alert alert--error blocks-radius" id="EmailCapture-error--{{ section.id }}">
              {% render 'icon-error' %}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p
              class="form-message alert alert--success blocks-radius h6"
              id="EmailCapture-success--{{ section.id }}"
              tabindex="-1"
              autofocus
            >
              {% render 'icon-success' -%}
              {{- 'newsletter.success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </motion-element>

      {%- if section.settings.terms_text != blank -%}
        <motion-element
          class="email-capture__terms rte text-sm block"
          data-motion="fade-up"
          data-motion-delay="{{ motion_delay | plus: 50 }}"
        >
          {{- section.settings.terms_text -}}
        </motion-element>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email capture",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-inverse"
    },
    {
      "type": "range",
      "id": "box_width",
      "min": 500,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Box max width",
      "default": 780
    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Get First Access, Not More Spam",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.text_size.heading.label",
      "default": "h1",
      "options": [
        { "value": "h6", "label": "t:sections.all.text_size.options__h6.label" },
        { "value": "h5", "label": "t:sections.all.text_size.options__h5.label" },
        { "value": "h4", "label": "t:sections.all.text_size.options__h4.label" },
        { "value": "h3", "label": "t:sections.all.text_size.options__h3.label" },
        { "value": "h2", "label": "t:sections.all.text_size.options__h2.label" },
        { "value": "h1", "label": "t:sections.all.text_size.options__h1.label" },
        { "value": "hd3", "label": "t:sections.all.text_size.options__hd3.label" },
        { "value": "hd2", "label": "t:sections.all.text_size.options__hd2.label" },
        { "value": "hd1", "label": "t:sections.all.text_size.options__hd1.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.highlight_text.header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.all.highlight_text.paragraph.content"
    },
    {
      "type": "select",
      "id": "heading_highlight_style",
      "label": "t:sections.all.highlight_text.settings.highlight_style.label",
      "options": [
        { "value": "none", "label": "t:sections.all.highlight_text.settings.highlight_style.options__1.label" },
        { "value": "underline", "label": "t:sections.all.highlight_text.settings.highlight_style.options__2.label" }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>New drops, limited pieces and private offers — sent occasionally.</p>",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:sections.all.text_size.text.label",
      "default": "text-base",
      "options": [
        { "value": "text-sm", "label": "t:sections.all.text_size.options__small.label" },
        { "value": "text-base", "label": "t:sections.all.text_size.options__base.label" },
        { "value": "text-lg", "label": "t:sections.all.text_size.options__large.label" },
        { "value": "text-inherit", "label": "t:sections.all.text_size.options__inherit.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.form_settings_header"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Unlock First Access"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.all.button.button_style.label",
      "options": [
        { "value": "btn--primary", "label": "t:sections.all.button.button_style.options__1.label" },
        { "value": "btn--secondary", "label": "t:sections.all.button.button_style.options__2.label" },
        { "value": "btn--white", "label": "White" }
      ],
      "default": "btn--white"
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Caption text",
      "default": "<p>No spam. Unsubscribe any time.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        { "value": "fixed", "label": "t:sections.all.container.options__fixed.label" },
        { "value": "full", "label": "t:sections.all.container.options__full.label" }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label"
    }
  ],
  "presets": [
    {
      "name": "Email capture"
    }
  ]
}
{% endschema %}
