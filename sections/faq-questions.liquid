  ],
  "presets": [
    {
      "name": "FAQ questions",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Is this real gold?",
            "answer": "<p>Our jewellery is crafted with high-quality gold plating over premium base metals, giving you a real-gold look that lasts.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Will the colour fade?",
            "answer": "<p>With proper care — avoiding water, perfume and harsh chemicals — the colour is designed to stay vibrant for a long time.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "<p>Yes, our pieces are nickel-free and hypoallergenic, making them safe for everyday wear on sensitive skin.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Will it look like the photos?",
            "answer": "<p>Absolutely. All our product photos are true to life, so what you see is exactly what you get.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes, cash on delivery is available nationwide alongside secure online payment options.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if the ring doesn't fit?",
            "answer": "<p>No worries — we offer easy exchanges so you can get the perfect fit.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
