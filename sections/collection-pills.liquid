{{ 'section-collection-pills.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-pills-slider.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign motion_delay = 50
%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section--padding collection-pills color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <collection-pills-slider
      class="collection-pills__content block"
      data-items-desktop="{{ section.settings.items_desktop }}"
      data-items-mobile="{{ section.settings.items_mobile }}"
    >
      <div class="collection-pills__items swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign motion_delay = motion_delay | plus: 50
              assign collection = collections[block.settings.collection]
              assign label = block.settings.text | default: collection.title
            -%}
            <motion-element
              data-motion="fade-up"
              data-motion-delay="{{ motion_delay }}"
              class="collection-pill-wrap swiper-slide"
              {{ block.shopify_attributes }}
            >
              {%- if collection != blank -%}
                <a
                  href="{{ collection.url }}"
                  class="collection-pill flex items-center justify-center gap-x-2 rounded color-{{ block.settings.color_scheme }}"
                  aria-label="{{ label | strip_html }}"
                >
              {%- else -%}
                <span class="collection-pill flex items-center justify-center gap-x-2 rounded color-{{ block.settings.color_scheme }}" role="link" aria-disabled="true">
              {%- endif -%}
                  {%- if label != blank -%}
                    <span class="collection-pill__text">{{ label }}</span>
                  {%- endif -%}
              {%- if collection != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </motion-element>
          {%- endfor -%}
        </div>
      </div>
    </collection-pills-slider>
  </div>
</div>

{% schema %}
{
  "name": "Collection pills",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.carousel.name"
    },
    {
      "type": "range",
      "id": "items_desktop",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 12,
      "label": "Items per view (desktop)"
    },
    {
      "type": "range",
      "id": "items_mobile",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 2.2,
      "label": "Items per view (mobile)"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": true,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "full",
      "label": "t:sections.all.divider.settings.divider_width.label"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection pill",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.all.collection.title.label",
          "info": "t:sections.all.collection.title.info"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection pills",
      "blocks": [
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  }
}
{% endschema %}
