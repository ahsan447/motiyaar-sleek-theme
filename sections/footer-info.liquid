{{ 'section-footer-info.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign motion_delay = 50
  assign payment_icon_blocks = section.blocks | where: 'type', 'payment_icon'
-%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section--padding footer-info color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;--footer-info-accent: {{ section.settings.accent_color }};"
>
  <div class="page-width">
    <div class="footer-info__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <motion-element
              class="footer-info__col footer-info__col--brand block"
              data-motion="fade-up"
              data-motion-delay="{{ motion_delay }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading != blank -%}
                <p class="footer-info__brand-name">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer-info__brand-text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_rating and block.settings.rating_text != blank -%}
                <div class="footer-info__rating inline-flex items-center">
                  {%- if block.settings.rating_stars != 'none' -%}
                    <span class="footer-info__rating-stars flex items-center" aria-hidden="true">
                      {% render 'icon-testimonial', icon_name: block.settings.rating_stars, size: 'small' %}
                    </span>
                  {%- endif -%}
                  <span class="footer-info__rating-text">{{ block.settings.rating_text }}</span>
                </div>
              {%- endif -%}
            </motion-element>
            {%- assign motion_delay = motion_delay | plus: 50 -%}
          {%- when 'link_column' -%}
            {%- liquid
              assign column_heading = block.settings.heading
              if column_heading == blank
                assign column_heading = linklists[block.settings.menu].title
              endif
            -%}
            {%- if block.settings.menu != blank -%}
              <motion-element
                class="footer-info__col block"
                data-motion="fade-up"
                data-motion-delay="{{ motion_delay }}"
                {{ block.shopify_attributes }}
              >
                {%- if column_heading != blank -%}
                  <p class="footer-info__col-heading">{{ column_heading }}</p>
                {%- endif -%}
                <ul class="footer-info__links list-unstyled">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a class="footer-info__link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </motion-element>
              {%- assign motion_delay = motion_delay | plus: 50 -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer-info__bottom flex items-center justify-between">
      <p class="footer-info__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {%- if section.settings.copyright_text != blank %} {{ section.settings.copyright_text }}{% endif -%}
      </p>
      {%- if section.settings.show_payment_badges and payment_icon_blocks.size > 0 -%}
        <ul class="footer-info__payment list-unstyled flex flex-wrap items-center">
          {%- for block in payment_icon_blocks -%}
            {%- if block.settings.icon != blank -%}
              <li class="footer-info__payment-badge" {{ block.shopify_attributes }}>
                {{
                  block.settings.icon
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', alt: block.settings.label, class: 'footer-info__payment-icon'
                }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer info",
  "class": "section",
  "max_blocks": 24,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-inverse"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (headings, stars)",
      "default": "#d8a35c"
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "info": "Shown after the automatic year, e.g. © 2026 Motiyaar · Lahore, Pakistan",
      "default": "Motiyaar · Lahore, Pakistan"
    },
    {
      "type": "checkbox",
      "id": "show_payment_badges",
      "label": "Show payment badges",
      "info": "Add payment icon blocks below to control which logos appear.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "full",
      "label": "t:sections.all.divider.settings.divider_width.label"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "MOTIYAAR"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "<p>Everyday gold-plated jewellery made in Lahore. Designed to be worn, not saved for weddings.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show rating badge",
          "default": true
        },
        {
          "type": "select",
          "id": "rating_stars",
          "label": "t:sections.testimonials.blocks.testimonial.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__1.label"
            },
            {
              "value": "1-star",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__2.label"
            },
            {
              "value": "2-stars",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__3.label"
            },
            {
              "value": "3-stars",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__4.label"
            },
            {
              "value": "4-stars",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__5.label"
            },
            {
              "value": "5-stars",
              "label": "t:sections.testimonials.blocks.testimonial.settings.icon.options__6.label"
            }
          ],
          "default": "5-stars"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "4.8 from 2,140 reviews"
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "info": "Leave blank to use the menu's own title.",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Create this menu under Online Store > Navigation, then select it here."
        }
      ]
    },
    {
      "type": "payment_icon",
      "name": "Payment icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (alt text)",
          "default": "Payment method"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "brand"
      },
      {
        "type": "link_column",
        "settings": {
          "heading": "Shop",
          "menu": "footer"
        }
      },
      {
        "type": "link_column",
        "settings": {
          "heading": "Help",
          "menu": "footer"
        }
      },
      {
        "type": "link_column",
        "settings": {
          "heading": "Contact",
          "menu": "footer"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Meezan Bank"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Nayapay"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Soneri Bank"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Easypaisa"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "JazzCash"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "American Express"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Mastercard"
        }
      },
      {
        "type": "payment_icon",
        "settings": {
          "label": "Visa"
        }
      }
    ]
  }
}
{% endschema %}
