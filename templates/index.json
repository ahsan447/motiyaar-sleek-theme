          }
        },
        "question_Fq02cD": {
          "type": "question",
          "settings": {
            "question": "Will the colour fade?",
            "answer": "<p>With proper care — avoiding water, perfume and harsh chemicals — the colour is designed to stay vibrant for a long time.</p>",
            "open": false
          }
        },
        "question_Fq03eF": {
          "type": "question",
          "settings": {
            "question": "How long will my order take to arrive?",
            "answer": "<p>Orders are usually processed within <strong>1 working days</strong> and delivered within approximately <strong>[3–7] working days</strong>. Delivery times may be longer during sales, public holidays, severe weather or high-order periods.<br/><br/></p>",
            "open": false
          }
        },
        "question_Fq04gH": {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Cash on Delivery is available for eligible orders and delivery locations across Pakistan. Certain high-value, customised or promotional orders may require advance payment.</p>",
            "open": false
          }
        },
        "question_Fq05iJ": {
          "type": "question",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes, cash on delivery is available nationwide alongside secure online payment options.</p>",
            "open": false
          }
        },
        "question_Fq06kL": {
          "type": "question",
          "settings": {
            "question": "Can I return or exchange my order?",
            "answer": "<p><br/>Eligible unused items may be exchanged within 7<strong>days</strong> of delivery, provided they are unworn, undamaged and returned with their original packaging. Earrings, customized pieces and sale items may be excluded for hygiene or policy reasons.<br/><br/></p>",
            "open": false
          }
        }
