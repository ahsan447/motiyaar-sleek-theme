{%- liquid
  assign recommendation_collection = product.collections.first
  assign rendered_count = 0
-%}
{%- capture recommendation_slides -%}
  {%- for candidate in recommendation_collection.products -%}
    {%- assign is_excluded = false -%}
    {%- if candidate.id == product.id -%}
      {%- assign is_excluded = true -%}
    {%- endif -%}
    {%- unless is_excluded -%}
      {%- for cart_item in cart.items -%}
        {%- if cart_item.product_id == candidate.id -%}
          {%- assign is_excluded = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
    {%- unless is_excluded -%}
      {%- assign rendered_count = rendered_count | plus: 1 -%}
      <div class="swiper-slide">
        {%- render 'card-product-list', product: candidate -%}
      </div>
    {%- endunless -%}
    {%- if rendered_count == 24 -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rendered_count > 0 -%}
  <cart-drawer-products-recommendation
    class="cart-drawer-products-recommendation flex flex-col gap-3 hidden"
    data-limit="{{ limit }}"
  >
    <div class="cart-drawer-products-recommendation__header flex items-center justify-between">
      <p class="h5">{{ heading | escape }}</p>
      {%- if rendered_count > 1 -%}
        <div class="slider-controls slider-controls--fraction-group">
          <button
            class="swiper-button-prev"
            name="previous"
            aria-label="{{ 'general.pagination.previous' | t }}"
          >
            {%- render 'icon-slider-prev', size: 'small' -%}
          </button>
          <div class="swiper-pagination"></div>
          <button
            class="swiper-button-next"
            name="next"
            aria-label="{{ 'general.pagination.next' | t }}"
          >
            {%- render 'icon-slider-next', size: 'small' -%}
          </button>
        </div>
      {%- endif -%}
    </div>
    <div class="blocks-radius">
      <div class="swiper">
        <div class="swiper-wrapper">
          {{- recommendation_slides -}}
        </div>
      </div>
    </div>
  </cart-drawer-products-recommendation>
{%- endif -%}
