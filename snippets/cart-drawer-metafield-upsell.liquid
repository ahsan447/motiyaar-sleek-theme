{%- comment -%}
  Walks every cart line item's product metafield
  custom.line_item_recommendation_products (list.product_reference) and
  renders the referenced products in one combined slider. Line items
  without the metafield are simply skipped; line items with it all
  contribute. Products already in the cart, sold-out products, and
  duplicates across line items are excluded.
{%- endcomment -%}
{%- liquid
  assign limit = limit | default: 4

  assign cart_product_ids = ''
  for cart_item in cart.items
    assign cart_product_ids = cart_product_ids | append: cart_item.product_id | append: '-'
  endfor
-%}
{%- capture upsell_cards -%}
  {%- liquid
    assign seen_ids = ''
    assign upsell_count = 0
    assign total_candidates = 0
  -%}
  {%- for cart_item in cart.items -%}
    {%- assign line_item_recs = cart_item.product.metafields.custom.line_item_recommendation_products.value -%}
    {%- assign total_candidates = total_candidates | plus: line_item_recs.size -%}
    {%- for candidate in line_item_recs -%}
      {%- assign id_token = candidate.id | append: '-' -%}
      {%- if candidate == blank or candidate.available == false or cart_product_ids contains id_token or seen_ids contains id_token or upsell_count >= limit -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign seen_ids = seen_ids | append: id_token -%}
      {%- assign upsell_count = upsell_count | plus: 1 -%}
      <div class="swiper-slide">
        {%- render 'cart-drawer-upsell-card', product: candidate -%}
      </div>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if true -%}
  <div style="padding:10px;margin-bottom:10px;border:1px dashed #999;font-size:12px;font-family:monospace;background:#fafafa;color:#333;">
    <strong>Upsell debug (TEMPORARY - visible to everyone right now):</strong><br>
    Cart items: {{ cart.item_count }}<br>
    {%- for cart_item in cart.items -%}
      &bull; {{ cart_item.product.title }} (id {{ cart_item.product_id }}) &rarr;
      {%- assign debug_recs = cart_item.product.metafields.custom.line_item_recommendation_products -%}
      {%- if debug_recs == blank -%}
        metafield empty/not set
      {%- else -%}
        metafield type: {{ debug_recs.type }}, value: {{ debug_recs.value.size }} product(s)
      {%- endif -%}
      <br>
    {%- endfor -%}
    Total candidates seen: {{ total_candidates }}<br>
    Shown after filtering: {{ upsell_count }}
  </div>
{%- endif -%}
{%- if upsell_count > 0 -%}
  <cart-drawer-metafield-upsell class="cart-drawer-products-recommendation cart-drawer-metafield-upsell flex flex-col gap-3">
    <div class="cart-drawer-products-recommendation__header flex items-center justify-between">
      <p class="h5">{{ heading | escape }}</p>
      {%- if upsell_count > 1 -%}
        <div class="slider-controls slider-controls--fraction-group">
          <button class="swiper-button-prev" name="previous" aria-label="{{ 'general.pagination.previous' | t }}">
            {%- render 'icon-slider-prev', size: 'small' -%}
          </button>
          <div class="swiper-pagination"></div>
          <button class="swiper-button-next" name="next" aria-label="{{ 'general.pagination.next' | t }}">
            {%- render 'icon-slider-next', size: 'small' -%}
          </button>
        </div>
      {%- endif -%}
    </div>
    <div class="blocks-radius">
      <div class="swiper">
        <div class="swiper-wrapper">
          {{- upsell_cards -}}
        </div>
      </div>
    </div>
  </cart-drawer-metafield-upsell>
{%- endif -%}
