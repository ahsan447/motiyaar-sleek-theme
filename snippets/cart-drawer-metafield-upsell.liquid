{%- comment -%}
  Walks every cart line item's product metafield
  custom.line_item_recommendation_products (list.product_reference) and
  renders the referenced products in one combined, horizontally
  scrollable strip. Line items without the metafield are simply
  skipped; line items with it all contribute. Products already in the
  cart, sold-out products, and duplicates across line items are
  excluded. Pure CSS scroll-snap, no JS/Swiper dependency.
{%- endcomment -%}
{%- liquid
  assign limit = limit | default: 4

  assign cart_product_ids = ''
  for cart_item in cart.items
    assign cart_product_ids = cart_product_ids | append: cart_item.product_id | append: '-'
  endfor
-%}
{%- capture upsell_cards -%}
  {%- liquid
    assign seen_ids = ''
    assign upsell_count = 0
  -%}
  {%- for cart_item in cart.items -%}
    {%- assign line_item_recs = cart_item.product.metafields.custom.line_item_recommendation_products.value -%}
    {%- for candidate in line_item_recs -%}
      {%- assign id_token = candidate.id | append: '-' -%}
      {%- if candidate == blank or candidate.available == false or cart_product_ids contains id_token or seen_ids contains id_token or upsell_count >= limit -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign seen_ids = seen_ids | append: id_token -%}
      {%- assign upsell_count = upsell_count | plus: 1 -%}
      <div class="cart-drawer-metafield-upsell__item">
        {%- render 'cart-drawer-upsell-card', product: candidate -%}
      </div>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if upsell_count > 0 -%}
  <div class="cart-drawer-metafield-upsell flex flex-col gap-3">
    <p class="h5">{{ heading | escape }}</p>
    <div class="cart-drawer-metafield-upsell__scroll">
      {{- upsell_cards -}}
    </div>
  </div>
{%- endif -%}
